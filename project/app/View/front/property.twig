<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f8fafc;
        }
        .property-card {
            transition: transform 0.3s ease-in-out;
        }
        .property-card:hover {
            transform: translateY(-5px);
        }
        .image-gallery {
            transition: transform 0.3s ease;
        }
        .image-gallery:hover {
            transform: scale(1.02);
        }
        .glassmorphism {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
        }
        .custom-shadow {
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
<!-- Enhanced Navigation Menu -->
<nav class="bg-white shadow-sm fixed w-full z-50">
    <div class="container mx-auto px-6">
        <div class="flex items-center justify-between h-20">
            <!-- Logo -->
            <div class="flex items-center">
                <img src="https://ultra-vacation-rentals.b-cdn.net/wp-content/uploads/sites/9/2020/09/Realhomes-logo-svg-blue-with-black-svg.png" alt="Logo" class="h-14">
            </div>

            <!-- Main Navigation -->
            <div class="hidden lg:flex items-center space-x-1">
                <a href="/home" class="px-4 py-2 rounded-md text-blue-600 bg-blue-50 font-medium">Home</a>
                <a href="/property" class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-50 font-medium transition-colors">Properties</a>
                <a href="#" class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-50 font-medium transition-colors">Become a Host</a>
                <a href="#" class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-50 font-medium transition-colors">Blog</a>
                <a href="#" class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-50 font-medium transition-colors">Contact</a>
            </div>

            <!-- Right Side -->
            <div class="flex items-center space-x-6">
                <div class="hidden md:flex items-center space-x-2 text-gray-600">
                    <i class="fas fa-phone text-blue-600"></i>
                    <span class="font-medium">1-800-555-1234</span>
                </div>
                <div class="flex items-center space-x-3">
                    <button class="p-2 rounded-full hover:bg-gray-100 text-gray-600">
                        <i class="fas fa-user-circle text-xl"></i>
                    </button>
                    <button class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-md font-medium transition-colors">
                        Registre
                    </button>
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<div class="relative bg-gradient-to-r from-blue-600 to-indigo-600 h-96">
    <div class="absolute inset-0">
        <img src="https://plus.unsplash.com/premium_photo-1684508638760-72ad80c0055f?q=80&w=2071&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Hero" class="w-full h-full object-cover opacity-20">
    </div>
    <div class="relative container mx-auto px-4 h-full flex flex-col justify-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
            Find Your Dream Property
        </h1>
        <p class="text-xl text-white/90 mb-8">
            Discover the perfect place to call home from our curated collection
        </p>
        <!-- Search Form -->
        <div class="w-full max-w-3xl">
            <form id="searchForm" class="flex flex-col md:flex-row gap-4">
                <input type="text"
                       id="searchInput"
                       class="flex-1 px-6 py-4 rounded-xl border-0 focus:ring-2 focus:ring-blue-400"
                       placeholder="Search by location, property type, or features...">
                <button type="submit"
                        class="px-8 py-4 bg-blue-500 hover:bg-blue-600 text-white rounded-xl transition duration-300 font-semibold">
                    <i class="fas fa-search mr-2"></i> Search
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container mx-auto px-4 -mt-20 relative z-10 pb-20">
    <!-- Properties Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for property in properties %}
            <div class="property-card bg-white rounded-2xl overflow-hidden custom-shadow">
                <!-- Property Images -->
                <div class="relative h-64">
                    {% if property.photos is iterable %}
                        <img src="{{ property.photos[0] }}"
                             alt="{{ property.title }}"
                             class="w-full h-full object-cover"
                             onerror="this.src='https://via.placeholder.com/800x600?text=No+Image+Available'">
                    {% elseif property.photos|length > 0 %}
                        {% set photos = property.photos|replace({'{': '', '}': ''})|split(',') %}
                        <img src="{{ photos[0]|trim('" ') }}"
                             alt="{{ property.title }}"
                             class="w-full h-full object-cover"
                             onerror="this.src='https://via.placeholder.com/800x600?text=No+Image+Available'">
                    {% else %}
                        <img src="https://via.placeholder.com/800x600?text=No+Image+Available"
                             alt="No image available"
                             class="w-full h-full object-cover">
                    {% endif %}

                    <!-- Price Badge -->
                    <div class="absolute top-4 right-4 glassmorphism px-6 py-2 rounded-full">
                        <span class="text-blue-600 font-semibold">${{ property.price }}/night</span>
                    </div>

                    <!-- Category Badge -->
                    <div class="absolute top-4 left-4 glassmorphism px-4 py-1 rounded-full">
                        <span class="text-gray-700 text-sm">{{ property.category_name }}</span>
                    </div>

                    <!-- Availability Badge -->
                    {% if property.is_available %}
                        <div class="absolute bottom-4 right-4 bg-green-500 text-white px-4 py-1 rounded-full text-sm">
                            Available
                        </div>
                    {% else %}
                        <div class="absolute bottom-4 right-4 bg-red-500 text-white px-4 py-1 rounded-full text-sm">
                            Not Available
                        </div>
                    {% endif %}
                </div>

                <!-- Property Details -->
                <div class="p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-2 hover:text-blue-600 transition duration-300">
                        {{ property.title }}
                    </h3>

                    <!-- Location -->
                    <p class="text-gray-600 mb-4 flex items-center">
                        <i class="fas fa-map-marker-alt text-blue-500 mr-2"></i>
                        {{ property.address }}
                    </p>

                    <!-- Amenities -->
                    <div class="grid grid-cols-3 gap-4 mb-6">
                        <div class="flex items-center text-gray-700">
                            <i class="fas fa-bed text-blue-500 mr-2"></i>
                            <span>{{ property.bedrooms }} Beds</span>
                        </div>
                        <div class="flex items-center text-gray-700">
                            <i class="fas fa-bath text-blue-500 mr-2"></i>
                            <span>{{ property.bathrooms }} Baths</span>
                        </div>
                        {% if property.rating %}
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-star text-yellow-400 mr-2"></i>
                                <span>{{ property.rating }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Owner Info -->
                    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                        <div class="flex items-center">
                            <img src="https://source.unsplash.com/100x100/?portrait"
                                 alt="{{ property.owner_name }}"
                                 class="w-10 h-10 rounded-full mr-3 border-2 border-blue-500">
                            <div>
                                <p class="font-medium text-gray-800">{{ property.owner_name }}</p>
                                <p class="text-sm text-gray-500">Property Owner</p>
                            </div>
                        </div>

                        <!-- View Details Button -->
                        <a href="/property/{{ property.id }}"
                           class="inline-flex items-center justify-center px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition duration-300">
                            <span>Details</span>
                            <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Search Script -->
<script>
    document.getElementById('searchForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const search = document.getElementById('searchInput').value;

        try {
            const response = await fetch('/property/search', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ search }),
            });

            const result = await response.json();
            if (result.success) {
                window.location.reload();
            }
        } catch (error) {
            console.error('Search failed:', error);
        }
    });
</script>

</body>
</html>